{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "5837-scouting",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"upload_source_maps": true,
	"routes": [
		{
			"pattern": "5837scout.app",
			"custom_domain": true
		},
		{
			"pattern": "admin.5837scout.app",
			"custom_domain": true
		}
	],
	"vars": {
		"CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuNTgzN3Njb3V0LmFwcCQ",
		"VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
	},
	"d1_databases": [
		{
			"binding": "SCOUTING_DB",
			"database_name": "scouting-data",
			"database_id": "c490e0d3-969c-4e28-bb5d-2f15ff3b8da8",
			"migrations_dir": "migrations"
		}
	]
}
